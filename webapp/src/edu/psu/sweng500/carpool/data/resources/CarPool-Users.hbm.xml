<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="edu.psu.sweng500.carpool.beans">
  <class name="User" table="USERS">
	<id column="ID" type="string" name="id"/>
	
	<property name="userName" column="USER_NAME" not-null="true"/>
	<property name="password" column="PASSWORD"/>
	<property name="givenName" column="GIVEN_NAME"/>
	<property name="surName" column="SURNAME"/>
	
	<many-to-one name="organization" column="ORGANIZATION_ID" unique="true" insert="false" update="false" outer-join="false"/>
	
	<set name="savedAddresses" lazy="true" table="USERS_ADDRESSES" cascade="all" >
        <key column="USER_ID" />
        <composite-element class="UserAddress" >
           <parent name="user"/>
           <property name="type" type="java.lang.String" column="TYPE"/>
           <many-to-one name="address" class="Address">
              <column name="ADDRESS_ID"/>
           </many-to-one>
        </composite-element>
    </set>
	
	<!-- 
	<set name="savedAddresses" table="USERS_ADDRESSES">
        <key column="USER_ID"/>
        <many-to-many column="ADDRESS_ID"
            unique="true"
            class="Address">
        </many-to-many>
    </set>
	-->
  </class>
  
  <class name="Organization" table="ORGANIZATIONS">
  	<id column="ID" type="string" name="id"/>
  	<property name="name" not-null="true" column="NAME"/>
  </class>
  
  <class name="Address" table="ADDRESSES">
  	<id column="ID" type="string" name="id"/>
  	<property name="name" not-null="true" column="NAME"/>
  	<property name="address1" column="ADDRESS_LINE_1"/>
  	<property name="address2" column="ADDRESS_LINE_2"/>
  	<property name="city" column="CITY"/>
  	<property name="stateOrProvince" column="STATE_OR_PROVINCE"/>
  	<property name="postalCode" column="POSTAL_CODE"/>
  	<property name="latitude" column="LATITUDE"/>
  	<property name="longitude" column="LONGITUDE"/>
  
  </class>
  
  <class name="Trip" table="TRIPS">
	<id column="ID" type="string" name="id"/>
	<property name="startDate" column="START_DATE_TIME" type="timestamp"/>
	<property name="endDate" column="END_DATE_TIME" type="timestamp"/>
	<property name="title" column="TITLE"/>
	
	<many-to-one name="organization" column="ORGANIZATION_ID" unique="true" insert="true" update="true" outer-join="false"/>
	
	<many-to-one name="startAddress" column="START_ADDRESS" unique="true" insert="true" update="true" outer-join="false"/>
	<many-to-one name="endAddress" column="END_ADDRESS" unique="true" insert="true" update="true" outer-join="false"/>
	
	<set name="members" table="TRIPS_MEMBERS">
        <key column="TRIP_ID"/>
        <many-to-many column="MEMBER_ID" unique="false" class="User"/>
        
    </set>
    <!-- 
	<join table="TRIPS_MEMBERS" optional="true">
        <key column="tripId" unique="true"/>
        <many-to-one name="userId" column="userId" not-null="true"/>
    </join>
    -->
	
  </class>
  
  <class name="edu.psu.sweng500.carpool.beans.TripUser" table="TRIPS_MEMBERS">
		<cache usage="read-write"/>
		<composite-id>
			<key-property name="tripId" column="TRIP_ID"></key-property>
			<key-property name="userId" column="MEMBER_ID"></key-property>
		</composite-id>
		<!--<one-to-one name="person" class="com.spx.contacts.beans.SPXWorker" outer-join="false">
		</one-to-one>
	-->
		
		<many-to-one name="user" column="MEMBER_ID" unique="true" insert="false" update="false" outer-join="false"/>
		<many-to-one name="trip" column="TRIP_ID" unique="true" insert="false" update="false" outer-join="false"/>
		<property name="type" column="TYPE"/>
		
	</class>
</hibernate-mapping>